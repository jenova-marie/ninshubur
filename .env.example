# Discord bot credentials
# Create a bot at https://discord.com/developers/applications
DISCORD_TOKEN=your-discord-bot-token-here
DISCORD_CLIENT_ID=your-application-client-id

# Optional: comma-separated list of guild IDs to restrict scraping to
# Leave blank to scrape every guild the bot joins
DISCORD_GUILD_IDS=

# Optional: comma-separated list of channel IDs to scrape
# Works for any text-bearing channel: text, announcement, forum, media
# Leave blank to scrape every supported channel in allowed guilds
CHANNEL_IDS=

# Optional: comma-separated list of user IDs to focus on
# (e.g. for user-targeted reporting/filtering downstream)
USER_IDS=

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ninshubur

# How many messages to pull per Discord REST request when backfilling (max 100)
BACKFILL_PAGE_SIZE=100

# How often (ms) to sweep archived threads looking for stale data
ARCHIVE_SWEEP_INTERVAL_MS=900000

# Anthropic — Haiku 4.5 powers tagging + grouping
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Voyage AI — produces embeddings for the message + group corpora
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# Qdrant — vector store; defaults to the local container
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_MESSAGES=ninshubur_messages
QDRANT_COLLECTION_GROUPS=ninshubur_groups

# Set to true to default `pnpm cli analyze tag/group` to the Anthropic
# Message Batches API (~50% discount, async). --batch / --no-batch on
# the CLI overrides this.
ANALYZE_BATCH_DEFAULT=false

# Logging
LOG_LEVEL=info
NODE_ENV=development
